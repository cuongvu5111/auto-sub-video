# ============================================================
# Cấu hình biến môi trường mẫu cho AutoSub Dubbing Studio
# ============================================================

# Cấu hình API mô hình ngôn ngữ (Chuẩn OpenAI-compatible)
# Có thể trỏ đến:
# - Ollama Local: http://localhost:11434/v1 (model: gemma3:4b hoặc gemma:2b)
# - Custom Gateway / Proxy: https://your-gateway.com/v1
# - OpenAI chính thức: https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT=60
# Increase to reduce request count only after checking provider latency and JSON quality.
LLM_TRANSLATION_BATCH_SIZE=4
FFMPEG_TIMEOUT=1800
TTS_REQUEST_TIMEOUT=20
TTS_SEGMENT_TIMEOUT=60
# Edge TTS requests run with limited concurrency and a small start delay.
TTS_MAX_CONCURRENCY=2
TTS_REQUEST_PACING_SECONDS=0.2

# Cấu hình LLM dự phòng tự động chuyển khi model chính bị Rate Limit (429)
LLM_BACKUP_ENABLED=false
LLM_BACKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BACKUP_API_KEY=your_gemini_api_key_here
LLM_BACKUP_MODEL=gemini-2.5-flash

# Cấu hình Speech-to-Text (faster-whisper)
# Các model: tiny, base, small, medium, large-v3 (khuyên dùng 'base' hoặc 'small' cho CPU)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Lower beam size is faster; benchmark accuracy before changing the default of 5.
WHISPER_BEAM_SIZE=5
# Keep enabled when downstream features need per-word timing.
WHISPER_WORD_TIMESTAMPS=true

# Cấu hình giọng đọc mặc định (edge-tts)
# - vi-VN-NamMinhNeural (Nam truyền cảm)
# - vi-VN-HoaiMyNeural (Nữ nhẹ nhàng)
DEFAULT_VOICE=vi-VN-NamMinhNeural

# Cấu hình hòa âm mặc định
# Tỷ lệ âm lượng tiếng gốc khi lồng tiếng (0.05 đến 0.20)
DEFAULT_DUCKING_VOLUME=0.10

# Thư mục xuất video mặc định
DEFAULT_OUTPUT_DIR=output

# Giữ file trung gian sau khi xử lý để hỗ trợ debug (mặc định false)
KEEP_INTERMEDIATES=false
